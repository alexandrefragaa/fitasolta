# Turso/libSQL (nomes preferidos para Vercel e ferramentas atuais)
TURSO_DATABASE_URL=libsql://SEU-BANCO.turso.io
TURSO_AUTH_TOKEN=COLE_SEU_TOKEN_READ_WRITE_AQUI

# Compatibilidade com versões antigas do FitaSolta (opcional se os nomes acima existem)
# HOST_TURSO=libsql://SEU-BANCO.turso.io
# TOKEN_TURSO=COLE_SEU_TOKEN_READ_WRITE_AQUI

# Gere um segredo de sessão: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES

# Hash bcrypt da senha administrativa; nunca coloque a senha em texto aberto
ADMIN_PASSWORD_HASH=COLE_AQUI_O_HASH_BCRYPT

NODE_ENV=development
PORT=3333
