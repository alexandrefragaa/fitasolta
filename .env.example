# URL e token do mesmo banco Turso/libSQL. Para previews, use um banco de teste separado.
HOST_TURSO=libsql://SEU-BANCO.turso.io
TOKEN_TURSO=COLE_SEU_TOKEN_AQUI

# Nomes alternativos aceitos quando já usados pela integração Vercel/Turso.
# Não defina URLs/tokens de bancos diferentes entre si.
# TURSO_DATABASE_URL=libsql://SEU-BANCO.turso.io
# TURSO_AUTH_TOKEN=COLE_SEU_TOKEN_AQUI

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES

# Hash bcrypt da senha administrativa. Nunca coloque a senha em texto aberto.
ADMIN_PASSWORD_HASH=COLE_AQUI_O_HASH_BCRYPT

NODE_ENV=development
PORT=3333

# Revisão assistida por IA (opcional). A chave permanece apenas nas variáveis de ambiente.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Segredo aleatório para autenticar o endpoint agendado da Vercel (produção).
# Gere com: node -e "console.log(require(\'crypto\').randomBytes(48).toString(\'hex\'))"
CRON_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO
# O OPENAI_API_KEY continua sendo usado pelo analisador de links existente.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
